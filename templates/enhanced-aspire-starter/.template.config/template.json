{
  "$schema": "http://json.schemastore.org/template",
  "author": "vwzhang",
  "classifications": [
    ".NET",
    "Cloud",
    "Solution",
    "Web",
    "ASP.NET Core",
    "Aspire",
    "Blazor",
    "Admin",
    "PostgreSQL",
    "Redis",
    "Identity"
  ],
  "name": "Enhanced Aspire Starter",
  "identity": "Vwzhang.EnhancedAspireStarter.CSharp",
  "groupIdentity": "Vwzhang.EnhancedAspireStarter",
  "shortName": "enhanced-aspire-starter",
  "sourceName": "Starter",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "guids": [
    "f6e76cbf-2d79-4b8b-9023-113ac10e07f9"
  ],
  "symbols": {
    "authorName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Your Organization",
      "replaces": "vwzhang",
      "description": "Owner name used in generated project metadata and license text."
    },
    "projectNameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLower": true
      },
      "description": "Lowercase form of the generated project name."
    },
    "projectResourceName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "projectNameLower",
        "steps": [
          {
            "regex": "[^a-z0-9]",
            "replacement": ""
          }
        ]
      },
      "description": "Lowercase alphanumeric name used for local resources."
    },
    "databaseName": {
      "type": "generated",
      "generator": "join",
      "replaces": "starterdb",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "projectResourceName"
          },
          {
            "type": "const",
            "value": "db"
          }
        ],
        "separator": "",
        "removeEmptyValues": true
      },
      "description": "PostgreSQL database and connection string name."
    },
    "databaseVariableName": {
      "type": "generated",
      "generator": "join",
      "replaces": "starterDb",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "projectResourceName"
          },
          {
            "type": "const",
            "value": "Db"
          }
        ],
        "separator": "",
        "removeEmptyValues": true
      },
      "description": "C# local variable name for the PostgreSQL database resource."
    },
    "localEmailDomain": {
      "type": "generated",
      "generator": "join",
      "replaces": "starter.local",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "projectResourceName"
          },
          {
            "type": "const",
            "value": ".local"
          }
        ],
        "separator": "",
        "removeEmptyValues": true
      },
      "description": "Local email domain used by seeded test users and SMTP defaults."
    },
    "stylePrefix": {
      "type": "generated",
      "generator": "join",
      "replaces": "starter-",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "projectResourceName"
          },
          {
            "type": "const",
            "value": "-"
          }
        ],
        "separator": "",
        "removeEmptyValues": true
      },
      "description": "CSS class prefix derived from the generated project name."
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".vs/**",
            ".agents/**",
            ".codex/**",
            ".claude/**",
            ".playwright-cli/**",
            "**/bin/**",
            "**/obj/**",
            "AGENTS.md",
            ".mcp.json"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "Starter.slnx"
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore' in the generated solution directory."
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
